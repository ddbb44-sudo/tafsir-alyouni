---
import Button from '../ui/Button.astro';
---
<Button id="btn-theme" label="تبديل المظهر" title="تبديل المظهر (فاتح/داكن)">
  <svg id="icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
  <svg id="icon-moon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
</Button>

<style>
  /* تُظهر الأيقونة المناسبة للوضع الحالي */
  :global(html.dark) #icon-moon { display: none; }
  :global(html:not(.dark)) #icon-sun { display: none; }
</style>

<script>
  const btn = document.getElementById('btn-theme');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const nowDark = !root.classList.contains('dark');
    root.classList.toggle('dark', nowDark);
    root.classList.toggle('light', !nowDark);
    root.style.colorScheme = nowDark ? 'dark' : 'light';
    try { localStorage.setItem('theme', nowDark ? 'dark' : 'light'); } catch (e) {}
    btn.setAttribute('aria-pressed', String(nowDark));
  });
</script>
