---
// بوابة كلمة مرور للصفحة الرئيسية. الحماية شكلية فقط: الموقع ثابت وكلمة المرور داخل الصفحة.
const { code = '5566' } = Astro.props;
---
<div id="gate" data-code={code} hidden>
  <form id="gate-form">
    <label for="gate-input">أدخل كلمة المرور</label>
    <input id="gate-input" type="password" inputmode="numeric" autocomplete="off" autofocus />
    <button type="submit">دخول</button>
    <p id="gate-error" hidden>كلمة المرور غير صحيحة</p>
  </form>
</div>

<style>
  #gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg, #fff);
  }
  #gate[hidden] { display: none; }
  #gate form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(20rem, 85vw);
    text-align: center;
  }
  #gate label { font-size: 1.1rem; }
  #gate input {
    padding: 0.6rem;
    font-size: 1.2rem;
    text-align: center;
    border: 1px solid var(--color-border, #ccc);
    border-radius: 8px;
    background: inherit;
    color: inherit;
  }
  #gate button {
    padding: 0.6rem;
    font-size: 1rem;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    background: var(--color-accent, #1f6f5c);
    color: #fff;
  }
  #gate #gate-error { color: #b3261e; margin: 0; }
</style>

<script is:inline>
  (function () {
    var gate = document.getElementById('gate');
    if (!gate) return;
    var KEY = 'tafsir-gate';
    var code = gate.dataset.code;
    var ok = false;
    try { ok = localStorage.getItem(KEY) === code; } catch (e) { ok = false; }
    if (ok) { gate.remove(); return; }
    document.documentElement.style.overflow = 'hidden';
    gate.hidden = false;
    var input = document.getElementById('gate-input');
    if (input) input.focus();
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); check(); }
    });
    document.getElementById('gate-form').addEventListener('submit', function (e) {
      e.preventDefault();
      check();
    });
    function check() {
      if (input.value.trim() === code) {
        try { localStorage.setItem(KEY, code); } catch (err) {}
        document.documentElement.style.overflow = '';
        gate.remove();
      } else {
        document.getElementById('gate-error').hidden = false;
        input.value = '';
        input.focus();
      }
    }
  })();
</script>
